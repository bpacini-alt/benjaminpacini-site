// Cloudflare Worker settings.
// Serves the site folder as the website at benjaminpacini.com.
// The Worker handles live application submissions and token-protected reviewer APIs.
{
  "name": "benjaminpacini-site",
  "compatibility_date": "2026-09-01",
  "main": "./src/index.js",
  "previews": {},
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "TA_APPLICATIONS_DB",
      "database_name": "ta-applications-prod",
      "database_id": "b3c92410-2de7-4826-a220-eba399cd5f20",
      "migrations_dir": "migrations"
    }
  ]
}
